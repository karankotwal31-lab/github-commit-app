{
  "name": "aria-for-vscode",
  "displayName": "Aria for VS Code",
  "description": "Your Aria engineering inbox and account, right in the editor. Reuses your Aria personal access token — the backend enforces scoping server-side.",
  "version": "0.1.0",
  "publisher": "aria",
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aria.signIn",
        "title": "Aria: Sign in (paste access token)"
      },
      {
        "command": "aria.signOut",
        "title": "Aria: Sign out"
      },
      {
        "command": "aria.refresh",
        "title": "Aria: Refresh inbox"
      },
      {
        "command": "aria.openInAria",
        "title": "Aria: Open in Aria",
        "when": "resourceScheme == file"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aria",
          "title": "Aria",
          "icon": "media/aria.svg"
        }
      ]
    },
    "views": {
      "aria": [
        {
          "id": "aria.inbox",
          "name": "Inbox",
          "icon": "media/inbox.svg",
          "contextualTitle": "Aria Inbox"
        },
        {
          "id": "aria.account",
          "name": "Account",
          "icon": "media/account.svg",
          "contextualTitle": "Aria Account"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "aria.openInAria",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "aria.refresh",
          "when": "view == aria.inbox",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Aria",
      "properties": {
        "aria.url": {
          "type": "string",
          "default": "https://steady-scorpion-839.convex.site",
          "description": "Aria backend URL"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
