# Browser-visible build configuration
VITE_CONVEX_URL=
VITE_VAPID_PUBLIC_KEY=

# Convex local/deployment selection
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=http://localhost:5173

# Public application origin used for trusted redirects and Stripe return URLs.
# Production must be an absolute HTTPS origin, e.g. https://aria.example.com
SITE_URL=http://localhost:5173

# Server-only Convex environment variables are configured in the Convex
# deployment, not exposed through Vite. See README.md / LAUNCH.md for:
# GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, OPENROUTER_API_KEY,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID_*,
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, RESEND_API_KEY, etc.
