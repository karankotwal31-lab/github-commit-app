# Browser-visible build configuration (safe to expose to the client bundle)
VITE_CONVEX_URL=
VITE_VAPID_PUBLIC_KEY=

# Convex local/deployment selection
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=http://localhost:5173

# Public application origin used for trusted OAuth redirects and Stripe return URLs.
# Production must be an absolute HTTPS origin, e.g. https://aria.example.com
SITE_URL=http://localhost:5173

# Server-only Convex environment variables belong in the Convex deployment
# environment. Never prefix these with VITE_ and never commit real values.
#
# Required for GitHub OAuth:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# Required for email OTP sign-in:
# FREEBUFF_EMAIL_API_KEY=
# Optional override; defaults to https://auth.freebuff.app/send_otp
# FREEBUFF_EMAIL_API_URL=
#
# Required for Ask Aria:
# OPENROUTER_API_KEY=
# Optional model override:
# OPENROUTER_MODEL=
#
# Required when billing is enabled:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_PRO=
# STRIPE_PRICE_ID_PRO_PLUS=
# STRIPE_PRICE_ID_TEAM=
# Legacy Pro fallback only: STRIPE_PRICE_ID=
#
# Required when web push is enabled. VAPID_PUBLIC_KEY must exactly match
# VITE_VAPID_PUBLIC_KEY used by the browser build.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
#
# Optional integrations:
# RESEND_API_KEY=
# AIRBRAKE_PROJECT_ID=
# AIRBRAKE_API_KEY=
# POSTHOG_API_KEY=
# POSTHOG_API_HOST=
